# ─────────────────────────────────────────────────────────────────────────────
# google-ads-mcp-server configuration
# All four credentials below are required. See the README for how to get them.
# ─────────────────────────────────────────────────────────────────────────────

# Your Google Ads API developer token, from the API Center of a manager
# account. It needs at least Basic Access, which Google reviews.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth client, created in a Google Cloud project with the Google Ads API
# enabled. Use a Desktop app client for local use.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token obtained once through the OAuth consent flow, for the account
# that can see the ad accounts you want to reach.
GOOGLE_ADS_REFRESH_TOKEN=

# Optional. The manager (MCC) account ID, when the accounts you query sit
# under one. Dashes are accepted and stripped.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Recommended. The customer IDs every tool may read or change, separated by
# commas. Dashes are accepted. Unset, every account these credentials reach is
# available. The variable becomes required in 3.0.0.
# GOOGLE_ADS_ACCOUNT_IDS=123-456-7890,234-567-8901

# Write tools are OFF by default. Set to true to register the 13 write tools.
# Every write still previews first and applies only on a second call
# with confirm: true. The values 1, yes and on still work in 2.x; 3.0.0 will
# accept only true.
# GOOGLE_ADS_ENABLE_WRITES=true

# debug | info | warn | error
# LOG_LEVEL=info
